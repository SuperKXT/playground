{
	"name": "playground",
	"version": "1.0.0",
	"license": "MIT",
	"author": "Saad Khan",
	"type": "module",
	"scripts": {
		"lint": "eslint . --max-warnings=0 --cache --fix && pnpm format && pnpm spellcheck",
		"format": "prettier --cache --write --log-level silent .",
		"test": "vitest watch",
		"test-ui": "vitest --ui",
		"tsc": "tsc",
		"typecheck": "vitest --typecheck",
		"wordle": "tsx ./scripts/wordle/wordle.ts",
		"kebab-rename": "tsx ./scripts/recursive-rename/recursive-rename.ts",
		"md-csv": "tsx ./scripts/md-links-to-csv/script.ts",
		"rwc": "tsx ./scripts/rwc/rwc.ts",
		"spellcheck": "cspell . --quiet --cache",
		"diag": "tsc --extendedDiagnostics",
		"trace": "tsc --generateTrace ./trace && npx @typescript/analyze-trace trace"
	},
	"dependencies": {
		"@clack/prompts": "1.9.0",
		"dayjs": "1.11.23",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@total-typescript/ts-reset": "0.6.1",
		"@type-challenges/utils": "0.1.1",
		"@types/node": "26.6.6",
		"@typescript/analyze-trace": "0.11.1",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.28",
		"@vitest/ui": "5.1.0",
		"cspell": "10.4.1",
		"eslint": "10.14.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.18.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-only-warn": "1.2.1",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"packageManager": "pnpm@12.4.2"
}
